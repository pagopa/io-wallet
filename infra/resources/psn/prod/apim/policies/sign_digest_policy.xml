<policies>
  <inbound>
    <base />
    <set-variable name="signingKeyName" value="@((string)context.Request.MatchedParameters[&quot;keyName&quot;])" />
    <set-backend-service backend-id="wallet-key-vault-pool" />
    <authentication-managed-identity resource="https://vault.azure.net" />
    <rewrite-uri
      template="@(&quot;/keys/&quot; + (string)context.Variables[&quot;signingKeyName&quot;] + &quot;/sign?api-version=7.6&quot;)"
      copy-unmatched-params="false" />
  </inbound>
  <backend>
    <retry
      condition="@(context.Response != null &amp;&amp; context.Response.StatusCode == 429)"
      count="2"
      interval="1"
      max-interval="5"
      delta="1"
      first-fast-retry="false">
      <forward-request buffer-request-body="true" />
    </retry>
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>